# Copy to .env and fill in. Never commit .env.
#
# The database, Redis and storage values below are local-only defaults that match
# docker-compose.yml, so a fresh checkout works after copying this file. They are
# not secrets and must not be reused outside local development. Everything marked
# CHANGE_ME is a placeholder: generate real values (the app refuses to start in
# production while a secret still begins with CHANGE_ME).
#
# Variables are read and validated in one place: packages/config/src/env.ts.

# --- Core (Phase 1) ---
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
DATABASE_URL=postgresql://app:localdev@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=CHANGE_ME_GENERATE_32_RANDOM_BYTES
# Key used to encrypt OAuth tokens and other secrets stored in the database
ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_RANDOM_BYTES

# --- File storage, S3-compatible (RustFS locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ecommerce-media
S3_ACCESS_KEY_ID=localdev
S3_SECRET_ACCESS_KEY=localdev-secret
S3_PUBLIC_URL=http://localhost:9000/ecommerce-media

# ---------------------------------------------------------------------------
# Not read by any code yet. Listed so later phases have agreed names.
# ---------------------------------------------------------------------------

# --- Payments (Phase 3). PAYMENT_PROVIDER: mock | stripe ---
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Phase 3). EMAIL_PROVIDER: console | smtp. Mailpit listens on 1025 ---
EMAIL_PROVIDER=console
EMAIL_FROM=store@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- AI gateway (Phase 5). AI_PROVIDER: mock | anthropic | openai-compatible ---
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_DEFAULT_MODEL=
AI_FALLBACK_PROVIDER=
AI_MONTHLY_BUDGET_USD=50

# --- Social integrations (Phase 6) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Observability (Phase 10, optional earlier) ---
SENTRY_DSN=
