# Copy to .env and fill in. Placeholders only: never commit real values.
# Variables are read and validated in one place at startup (packages/config).
# "Required from" shows the phase in which a variable first becomes necessary.

# --- Core (Phase 1) ---
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://app:CHANGE_ME@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379
AUTH_SECRET=CHANGE_ME_GENERATE_32_RANDOM_BYTES
# Key used to encrypt OAuth tokens and other secrets stored in the database
ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_RANDOM_BYTES
LOG_LEVEL=info

# --- File storage, S3-compatible (Phase 2) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ecommerce-media
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PUBLIC_URL=http://localhost:9000/ecommerce-media

# --- Payments (Phase 3). PAYMENT_PROVIDER: mock | stripe ---
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Phase 3). EMAIL_PROVIDER: console | smtp ---
EMAIL_PROVIDER=console
EMAIL_FROM=store@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- AI gateway (Phase 5). AI_PROVIDER: mock | anthropic | openai-compatible ---
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_DEFAULT_MODEL=
AI_FALLBACK_PROVIDER=
AI_MONTHLY_BUDGET_USD=50

# --- Social integrations (Phase 6) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Observability (Phase 10, optional earlier) ---
SENTRY_DSN=
