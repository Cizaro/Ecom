{
  "name": "@ecom/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev && tsx scripts/sync-app-role.ts",
    "migrate:deploy": "prisma migrate deploy && tsx scripts/sync-app-role.ts",
    "migrate:status": "prisma migrate status",
    "typecheck": "tsc --noEmit",
    "migrate:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "@ecom/config": "workspace:*"
  }
}
