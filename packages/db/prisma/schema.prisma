// Source of truth for the database schema. Design reference: docs/DATA_MODEL.md.
//
// Conventions
// - Tables and columns are snake_case in the database (@@map / @map); tables are plural.
// - Primary keys are UUID v7, generated by the client.
// - Every tenant-owned table has tenant_id and a Row-Level Security policy. The
//   policy, grants for the runtime role and any trigger are hand-written SQL in
//   the same migration that creates the table. A test fails if a table has
//   neither RLS nor an entry in the list of global tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum TenantStatus {
  active
  suspended
  closed

  @@map("tenant_status")
}

model Tenant {
  id                    String       @id @default(uuid(7)) @db.Uuid
  name                  String
  slug                  String       @unique
  status                TenantStatus @default(active)
  /// Hard monthly cap for AI spend, in minor units of aiBudgetCurrency.
  aiMonthlyBudgetAmount Int?         @map("ai_monthly_budget_amount")
  aiBudgetCurrency      String?      @map("ai_budget_currency") @db.Char(3)
  /// Global pause for all AI automation in this tenant.
  automationPaused      Boolean      @default(false) @map("automation_paused")
  /// Staff with the owner or manager role must use two-factor authentication.
  requireStaffTwoFactor Boolean      @default(false) @map("require_staff_two_factor")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  stores                  Store[]
  storeDomains            StoreDomain[]
  activeSessions          Session[]
  memberships             UserTenantMembership[]
  roles                   Role[]
  consentRecords          ConsentRecord[]
  notificationPreferences NotificationPreference[]
  featureFlags            FeatureFlag[]
  idempotencyKeys         IdempotencyKey[]
  outboxEvents            OutboxEvent[]
  jobs                    Job[]
  categories              Category[]
  brands                  Brand[]
  products                Product[]
  productVariants         ProductVariant[]
  productAttributes       ProductAttribute[]

  @@map("tenants")
}

model Store {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  slug            String
  defaultLocale   String   @default("en") @map("default_locale")
  defaultCurrency String   @default("USD") @map("default_currency") @db.Char(3)
  timezone        String   @default("UTC")
  branding        Json     @default("{}")
  settings        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domains StoreDomain[]

  @@unique([tenantId, slug])
  @@index([tenantId, createdAt])
  @@map("stores")
}

/// Host names that serve a store's storefront. Looked up before any tenant
/// context exists, through the app.resolve_store_host() database function.
model StoreDomain {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  /// Lowercase, no port, no trailing dot (enforced by a check constraint).
  hostname  String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([storeId])
  @@map("store_domains")
}

// ---------------------------------------------------------------------------
// Identity and access (staff). Shoppers are a separate model added in Phase 3.
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lowercase (enforced by a check constraint).
  email            String     @unique
  name             String     @default("")
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  /// Maintained by the authentication library's two-factor plugin.
  twoFactorEnabled Boolean    @default(false) @map("mfa_enabled")
  /// Not readable by the runtime database role.
  isPlatformAdmin  Boolean    @default(false) @map("is_platform_admin")
  status           UserStatus @default(active)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships UserTenantMembership[]
  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Authentication tables. Their shape is dictated by the Better Auth library
// (model and field names must match what it expects). None of them is
// accessible to the runtime database role: Row-Level Security is enabled with
// no policies and no grants, so only the admin connection can touch them.
// ---------------------------------------------------------------------------

model Session {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Bearer credential. Stored as issued by the library (not hashed).
  token          String   @unique
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  /// The tenant this session is working in. Set only by the server after
  /// checking membership; never taken from client input.
  activeTenantId String?  @map("active_tenant_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant Tenant? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeTenantId])
  @@map("sessions")
}

/// One row per sign-in method. Email-and-password sign-in is providerId
/// "credential", with the Argon2id password hash in `password`.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens such as password-reset links.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

/// Two-factor secrets and backup codes, encrypted by the library.
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for system roles shared by every tenant.
  tenantId    String?  @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships UserTenantMembership[]

  // System role keys are unique through a partial index in the migration SQL.
  @@unique([tenantId, key])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// `module.action`, for example `orders.refund`.
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum MembershipStatus {
  invited
  active
  revoked

  @@map("membership_status")
}

model UserTenantMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  /// Empty means all stores of the tenant.
  storeIds  String[]         @default([]) @map("store_ids") @db.Uuid
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([roleId])
  @@map("user_tenant_memberships")
}

// ---------------------------------------------------------------------------
// Audit, consent, preferences
// ---------------------------------------------------------------------------

/// Append-only: a trigger rejects UPDATE, DELETE and TRUNCATE for every role.
/// tenant_id and actor_user_id deliberately have no foreign keys so audit
/// entries outlive the records they describe.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for platform-level events.
  tenantId    String?  @map("tenant_id") @db.Uuid
  /// `user`, `customer`, `system` or `platform_admin`.
  actorType   String   @map("actor_type")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId, createdAt])
  @@map("audit_logs")
}

enum SubjectType {
  user
  customer

  @@map("subject_type")
}

enum ConsentPurpose {
  marketing_email
  marketing_sms
  cookies_analytics
  cookies_marketing
  ugc_reuse

  @@map("consent_purpose")
}

/// One row per consent decision; withdrawing consent adds a row with granted = false.
/// subject_id gains a foreign key to customers when that table exists (Phase 3).
model ConsentRecord {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  subjectType   SubjectType    @map("subject_type")
  subjectId     String         @map("subject_id") @db.Uuid
  purpose       ConsentPurpose
  granted       Boolean
  source        String
  policyVersion String?        @map("policy_version")
  recordedAt    DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subjectType, subjectId, purpose, recordedAt])
  @@map("consent_records")
}

model NotificationPreference {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  subjectType SubjectType @map("subject_type")
  subjectId   String      @map("subject_id") @db.Uuid
  /// `email`, `sms`, `push`.
  channel     String
  /// For example `order_updates`, `marketing`, `giveaways`.
  category    String
  enabled     Boolean
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, subjectType, subjectId, channel, category])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Platform plumbing
// ---------------------------------------------------------------------------

model FeatureFlag {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Null for a global default; a tenant row overrides it.
  tenantId  String?  @map("tenant_id") @db.Uuid
  key       String
  enabled   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Global flag keys are unique through a partial index in the migration SQL.
  @@unique([tenantId, key])
  @@map("feature_flags")
}

model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  /// Hash of the request, to detect the same key reused with a different body.
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Transactional outbox: written in the same transaction as the change it
/// announces, drained by the worker.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([processedAt, createdAt])
  @@index([tenantId, createdAt])
  @@map("outbox_events")
}

enum JobStatus {
  queued
  running
  succeeded
  failed

  @@map("job_status")
}

/// Status record behind the background-job status API.
model Job {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  queue          String
  name           String
  status         JobStatus @default(queued)
  progress       Int       @default(0)
  result         Json?
  error          String?
  idempotencyKey String?   @map("idempotency_key")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// Catalog. Every table is tenant-owned. References between catalog tables are
// checked to stay inside one tenant by database triggers (see the migration).
// Media arrives in Milestone 2.2 and stock levels in Milestone 3.2.
// ---------------------------------------------------------------------------

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  /// Lowercase words joined by hyphens (enforced by a check constraint).
  slug           String
  description    String   @default("")
  position       Int      @default(0)
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId, position])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, name])
  @@map("brands")
}

enum ProductStatus {
  /// Being prepared; never shown to shoppers.
  draft
  /// Shown to shoppers.
  active
  /// Withdrawn; kept for order history.
  archived

  @@map("product_status")
}

model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  name             String
  slug             String
  shortDescription String        @default("") @map("short_description")
  description      String        @default("")
  seoTitle         String?       @map("seo_title")
  seoDescription   String?       @map("seo_description")
  brandId          String?       @map("brand_id") @db.Uuid
  categoryId       String?       @map("category_id") @db.Uuid
  /// For example "women", "men", "gift".
  audienceTags     String[]      @default([]) @map("audience_tags")
  material         String?
  careInfo         String?       @map("care_info")
  taxClass         String?       @map("tax_class")
  status           ProductStatus @default(draft)
  isFeatured       Boolean       @default(false) @map("is_featured")
  isNewArrival     Boolean       @default(false) @map("is_new_arrival")
  /// A manual merchandising flag, not a sales claim computed from orders.
  isBestSeller     Boolean       @default(false) @map("is_best_seller")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand      Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  attributes ProductAttribute[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@map("products")
}

enum VariantStatus {
  active
  /// Not for sale; kept so the SKU is not reused.
  inactive

  @@map("variant_status")
}

/// The thing that is actually sold: one SKU with its own price.
model ProductVariant {
  id                  String        @id @default(uuid(7)) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  productId           String        @map("product_id") @db.Uuid
  sku                 String
  barcode             String?
  color               String?
  size                String?
  /// Any further options, as { "Strap": "Leather" }.
  optionValues        Json          @default("{}") @map("option_values")
  /// Money is stored in minor units (cents) of `currency`.
  priceAmount         Int           @map("price_amount")
  /// Sale price, when lower than priceAmount.
  discountPriceAmount Int?          @map("discount_price_amount")
  /// "Was" price shown struck through. Must be a price really charged before.
  compareAtAmount     Int?          @map("compare_at_amount")
  /// What the store paid. Never shown to shoppers.
  costAmount          Int?          @map("cost_amount")
  currency            String        @db.Char(3)
  weightGrams         Int?          @map("weight_grams")
  lengthMm            Int?          @map("length_mm")
  widthMm             Int?          @map("width_mm")
  heightMm            Int?          @map("height_mm")
  lowStockThreshold   Int?          @map("low_stock_threshold")
  position            Int           @default(0)
  status              VariantStatus @default(active)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([productId, position])
  @@map("product_variants")
}

/// Specifications such as strap length or movement type.
model ProductAttribute {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  key       String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([tenantId])
  @@map("product_attributes")
}
