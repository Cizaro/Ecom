// Source of truth for the database schema. Design reference: docs/DATA_MODEL.md.
//
// Conventions
// - Tables and columns are snake_case in the database (@@map / @map); tables are plural.
// - Primary keys are UUID v7, generated by the client.
// - Every tenant-owned table has tenant_id and a Row-Level Security policy. The
//   policy, grants for the runtime role and any trigger are hand-written SQL in
//   the same migration that creates the table. A test fails if a table has
//   neither RLS nor an entry in the list of global tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum TenantStatus {
  active
  suspended
  closed

  @@map("tenant_status")
}

model Tenant {
  id                    String       @id @default(uuid(7)) @db.Uuid
  name                  String
  slug                  String       @unique
  status                TenantStatus @default(active)
  /// Hard monthly cap for AI spend, in minor units of aiBudgetCurrency.
  aiMonthlyBudgetAmount Int?         @map("ai_monthly_budget_amount")
  aiBudgetCurrency      String?      @map("ai_budget_currency") @db.Char(3)
  /// Global pause for all AI automation in this tenant.
  automationPaused      Boolean      @default(false) @map("automation_paused")
  /// Staff with the owner or manager role must use two-factor authentication.
  requireStaffTwoFactor Boolean      @default(false) @map("require_staff_two_factor")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  stores                  Store[]
  storeDomains            StoreDomain[]
  activeSessions          Session[]
  memberships             UserTenantMembership[]
  roles                   Role[]
  consentRecords          ConsentRecord[]
  notificationPreferences NotificationPreference[]
  featureFlags            FeatureFlag[]
  idempotencyKeys         IdempotencyKey[]
  outboxEvents            OutboxEvent[]
  jobs                    Job[]
  categories              Category[]
  brands                  Brand[]
  products                Product[]
  productVariants         ProductVariant[]
  productAttributes       ProductAttribute[]
  mediaAssets             MediaAsset[]
  productImages           ProductImage[]
  carts                   Cart[]
  cartItems               CartItem[]
  customers               Customer[]
  customerSessions        CustomerSession[]
  customerTokens          CustomerToken[]
  addresses               Address[]
  inventoryLocations      InventoryLocation[]
  inventoryLevels         InventoryLevel[]
  stockMovements          StockMovement[]
  stockReservations       StockReservation[]
  orders                  Order[]
  orderItems              OrderItem[]
  orderEvents             OrderEvent[]
  payments                Payment[]
  paymentEvents           PaymentEvent[]
  orderCounter            OrderCounter?
  shippingZones           ShippingZone[]
  checkoutSettings        CheckoutSettings?
  shipments               Shipment[]
  notificationSettings    NotificationSettings?
  orderReturns            OrderReturn[]
  orderReturnItems        OrderReturnItem[]

  @@map("tenants")
}

model Store {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  slug            String
  defaultLocale   String   @default("en") @map("default_locale")
  defaultCurrency String   @default("USD") @map("default_currency") @db.Char(3)
  timezone        String   @default("UTC")
  branding        Json     @default("{}")
  settings        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domains StoreDomain[]

  @@unique([tenantId, slug])
  @@index([tenantId, createdAt])
  @@map("stores")
}

/// Host names that serve a store's storefront. Looked up before any tenant
/// context exists, through the app.resolve_store_host() database function.
model StoreDomain {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  /// Lowercase, no port, no trailing dot (enforced by a check constraint).
  hostname  String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([storeId])
  @@map("store_domains")
}

// ---------------------------------------------------------------------------
// Identity and access (staff). Shoppers are a separate model added in Phase 3.
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lowercase (enforced by a check constraint).
  email            String     @unique
  name             String     @default("")
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  /// Maintained by the authentication library's two-factor plugin.
  twoFactorEnabled Boolean    @default(false) @map("mfa_enabled")
  /// Not readable by the runtime database role.
  isPlatformAdmin  Boolean    @default(false) @map("is_platform_admin")
  status           UserStatus @default(active)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships    UserTenantMembership[]
  sessions       Session[]
  accounts       Account[]
  twoFactors     TwoFactor[]
  uploadedMedia  MediaAsset[]
  stockMovements StockMovement[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Authentication tables. Their shape is dictated by the Better Auth library
// (model and field names must match what it expects). None of them is
// accessible to the runtime database role: Row-Level Security is enabled with
// no policies and no grants, so only the admin connection can touch them.
// ---------------------------------------------------------------------------

model Session {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Bearer credential. Stored as issued by the library (not hashed).
  token          String   @unique
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  /// The tenant this session is working in. Set only by the server after
  /// checking membership; never taken from client input.
  activeTenantId String?  @map("active_tenant_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant Tenant? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeTenantId])
  @@map("sessions")
}

/// One row per sign-in method. Email-and-password sign-in is providerId
/// "credential", with the Argon2id password hash in `password`.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens such as password-reset links.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

/// Two-factor secrets and backup codes, encrypted by the library.
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for system roles shared by every tenant.
  tenantId    String?  @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships UserTenantMembership[]

  // System role keys are unique through a partial index in the migration SQL.
  @@unique([tenantId, key])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// `module.action`, for example `orders.refund`.
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum MembershipStatus {
  invited
  active
  revoked

  @@map("membership_status")
}

model UserTenantMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  /// Empty means all stores of the tenant.
  storeIds  String[]         @default([]) @map("store_ids") @db.Uuid
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([roleId])
  @@map("user_tenant_memberships")
}

// ---------------------------------------------------------------------------
// Audit, consent, preferences
// ---------------------------------------------------------------------------

/// Append-only: a trigger rejects UPDATE, DELETE and TRUNCATE for every role.
/// tenant_id and actor_user_id deliberately have no foreign keys so audit
/// entries outlive the records they describe.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for platform-level events.
  tenantId    String?  @map("tenant_id") @db.Uuid
  /// `user`, `customer`, `system` or `platform_admin`.
  actorType   String   @map("actor_type")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId, createdAt])
  @@map("audit_logs")
}

enum SubjectType {
  user
  customer

  @@map("subject_type")
}

enum ConsentPurpose {
  marketing_email
  marketing_sms
  cookies_analytics
  cookies_marketing
  ugc_reuse

  @@map("consent_purpose")
}

/// One row per consent decision; withdrawing consent adds a row with granted = false.
/// subject_id gains a foreign key to customers when that table exists (Phase 3).
model ConsentRecord {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  subjectType   SubjectType    @map("subject_type")
  subjectId     String         @map("subject_id") @db.Uuid
  purpose       ConsentPurpose
  granted       Boolean
  source        String
  policyVersion String?        @map("policy_version")
  recordedAt    DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subjectType, subjectId, purpose, recordedAt])
  @@map("consent_records")
}

model NotificationPreference {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  subjectType SubjectType @map("subject_type")
  subjectId   String      @map("subject_id") @db.Uuid
  /// `email`, `sms`, `push`.
  channel     String
  /// For example `order_updates`, `marketing`, `giveaways`.
  category    String
  enabled     Boolean
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, subjectType, subjectId, channel, category])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Platform plumbing
// ---------------------------------------------------------------------------

model FeatureFlag {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Null for a global default; a tenant row overrides it.
  tenantId  String?  @map("tenant_id") @db.Uuid
  key       String
  enabled   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Global flag keys are unique through a partial index in the migration SQL.
  @@unique([tenantId, key])
  @@map("feature_flags")
}

model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  /// Hash of the request, to detect the same key reused with a different body.
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Transactional outbox: written in the same transaction as the change it
/// announces, drained by the worker.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  /// Not tried again before this time (set after a failed attempt).
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  /// Claimed by a sender until then, so two senders never send the same event.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  /// Makes the same event once only, e.g. one confirmation email per order.
  dedupeKey   String?   @map("dedupe_key")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([processedAt, createdAt])
  @@index([processedAt, availableAt])
  @@index([tenantId, createdAt])
  @@map("outbox_events")
}

enum JobStatus {
  queued
  running
  succeeded
  failed

  @@map("job_status")
}

/// Status record behind the background-job status API.
model Job {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  queue          String
  name           String
  status         JobStatus @default(queued)
  progress       Int       @default(0)
  result         Json?
  error          String?
  idempotencyKey String?   @map("idempotency_key")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// Catalog. Every table is tenant-owned. References between catalog tables are
// checked to stay inside one tenant by database triggers (see the migration).
// Stock levels arrive in Milestone 3.2.
// ---------------------------------------------------------------------------

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  /// Lowercase words joined by hyphens (enforced by a check constraint).
  slug           String
  description    String   @default("")
  position       Int      @default(0)
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  imageAssetId   String?  @unique @map("image_asset_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  image    MediaAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  parent   Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]  @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId, position])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  slug        String
  logoAssetId String?  @unique @map("logo_asset_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logo     MediaAsset? @relation(fields: [logoAssetId], references: [id], onDelete: SetNull)
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, name])
  @@map("brands")
}

enum ProductStatus {
  /// Being prepared; never shown to shoppers.
  draft
  /// Shown to shoppers.
  active
  /// Withdrawn; kept for order history.
  archived

  @@map("product_status")
}

model Product {
  id               String                   @id @default(uuid(7)) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  name             String
  slug             String
  shortDescription String                   @default("") @map("short_description")
  description      String                   @default("")
  seoTitle         String?                  @map("seo_title")
  seoDescription   String?                  @map("seo_description")
  brandId          String?                  @map("brand_id") @db.Uuid
  categoryId       String?                  @map("category_id") @db.Uuid
  /// For example "women", "men", "gift".
  audienceTags     String[]                 @default([]) @map("audience_tags")
  material         String?
  careInfo         String?                  @map("care_info")
  taxClass         String?                  @map("tax_class")
  status           ProductStatus            @default(draft)
  isFeatured       Boolean                  @default(false) @map("is_featured")
  isNewArrival     Boolean                  @default(false) @map("is_new_arrival")
  /// A manual merchandising flag, not a sales claim computed from orders.
  isBestSeller     Boolean                  @default(false) @map("is_best_seller")
  /// Words shoppers can search for. Kept up to date by a database trigger.
  searchVector     Unsupported("tsvector")? @map("search_vector")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand      Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  attributes ProductAttribute[]
  images     ProductImage[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@index([searchVector], type: Gin)
  @@map("products")
}

enum VariantStatus {
  active
  /// Not for sale; kept so the SKU is not reused.
  inactive

  @@map("variant_status")
}

/// The thing that is actually sold: one SKU with its own price.
model ProductVariant {
  id                  String        @id @default(uuid(7)) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  productId           String        @map("product_id") @db.Uuid
  sku                 String
  barcode             String?
  color               String?
  size                String?
  /// Any further options, as { "Strap": "Leather" }.
  optionValues        Json          @default("{}") @map("option_values")
  /// Money is stored in minor units (cents) of `currency`.
  priceAmount         Int           @map("price_amount")
  /// Sale price, when lower than priceAmount.
  discountPriceAmount Int?          @map("discount_price_amount")
  /// "Was" price shown struck through. Must be a price really charged before.
  compareAtAmount     Int?          @map("compare_at_amount")
  /// What the store paid. Never shown to shoppers.
  costAmount          Int?          @map("cost_amount")
  currency            String        @db.Char(3)
  weightGrams         Int?          @map("weight_grams")
  lengthMm            Int?          @map("length_mm")
  widthMm             Int?          @map("width_mm")
  heightMm            Int?          @map("height_mm")
  lowStockThreshold   Int?          @map("low_stock_threshold")
  position            Int           @default(0)
  status              VariantStatus @default(active)
  /// When false the store does not count this item: it is sold without a stock check.
  trackInventory      Boolean       @default(true) @map("track_inventory")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  images            ProductImage[]
  cartItems         CartItem[]
  inventoryLevels   InventoryLevel[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  orderItems        OrderItem[]

  @@unique([tenantId, sku])
  @@index([productId, position])
  @@map("product_variants")
}

/// Specifications such as strap length or movement type.
model ProductAttribute {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  key       String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([tenantId])
  @@map("product_attributes")
}

// ---------------------------------------------------------------------------
// Media. Files live in object storage; these rows describe them. Every stored
// file's key starts with "public/<tenant id>/" (enforced by a check constraint).
// ---------------------------------------------------------------------------

enum MediaKind {
  image
  video

  @@map("media_kind")
}

enum MediaStatus {
  /// Uploaded and usable; resized versions are still being made.
  processing
  ready
  /// Resizing failed; the uploaded file is still used.
  failed

  @@map("media_status")
}

/// One uploaded file after cleaning (re-encoded, metadata removed), plus its
/// resized versions. An asset is used in exactly one place.
model MediaAsset {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  kind            MediaKind   @default(image)
  status          MediaStatus @default(processing)
  storageKey      String      @unique @map("storage_key")
  mimeType        String      @map("mime_type")
  bytes           Int
  width           Int
  height          Int
  /// SHA-256 of the stored file, in hexadecimal.
  checksum        String
  /// Resized versions: [{ key, width, height, bytes, mimeType }].
  variants        Json        @default("[]")
  processingError String?     @map("processing_error")
  uploadedBy      String?     @map("uploaded_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader     User?         @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  productImage ProductImage?
  category     Category?
  brand        Brand?

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("media_assets")
}

/// A product's picture. The lowest position is the main image.
model ProductImage {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  /// Set when the picture shows one variant (for example one colour).
  variantId    String?  @map("variant_id") @db.Uuid
  mediaAssetId String   @unique @map("media_asset_id") @db.Uuid
  altText      String   @default("") @map("alt_text")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  asset   MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([tenantId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Cart. A visitor's cart is found by a random token kept in an HttpOnly
// cookie; only a hash of the token is stored, so reading this table does not
// let anyone open a cart.
// ---------------------------------------------------------------------------

enum CartStatus {
  active
  /// Turned into an order (Phase 3). Kept for the record, no longer editable.
  converted

  @@map("cart_status")
}

model Cart {
  id         String     @id @default(uuid(7)) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  /// SHA-256 of the cookie token, in hexadecimal.
  tokenHash  String     @unique @map("token_hash")
  /// Set when a signed-in customer owns the cart, so it follows them between devices.
  customerId String?    @map("customer_id") @db.Uuid
  currency   String     @db.Char(3)
  status     CartStatus @default(active)
  /// Pushed forward on every change; an expired cart is treated as empty.
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]
  orders   Order[]

  @@index([tenantId, status, expiresAt])
  @@index([customerId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  cartId          String   @map("cart_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  quantity        Int
  /// What the variant cost when it was added, to tell the shopper if the
  /// price has changed since. Totals always use the current price.
  unitPriceAmount Int      @map("unit_price_amount")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([tenantId])
  @@index([variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Customers. A customer belongs to one tenant: the same email address in two
// stores is two unrelated customers. Customers are not staff: they have their
// own tables, their own session cookie, and no way into the admin.
// ---------------------------------------------------------------------------

enum CustomerStatus {
  active
  /// Blocked from signing in by staff. Orders are kept.
  disabled

  @@map("customer_status")
}

model Customer {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  /// Always stored lowercase (enforced by a check constraint).
  email           String
  name            String         @default("")
  phone           String?
  /// Null until the customer sets one (guest checkouts create customers without).
  passwordHash    String?        @map("password_hash")
  /// When the customer proved they receive mail at this address.
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz(3)
  status          CustomerStatus @default(active)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions  CustomerSession[]
  tokens    CustomerToken[]
  addresses Address[]
  carts     Cart[]
  orders    Order[]

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@map("customers")
}

/// A signed-in browser. Only a hash of the cookie token is stored.
model CustomerSession {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

enum CustomerTokenPurpose {
  verify_email
  reset_password

  @@map("customer_token_purpose")
}

/// A single-use link sent by email. Only a hash of the token is stored.
model CustomerToken {
  id         String               @id @default(uuid(7)) @db.Uuid
  tenantId   String               @map("tenant_id") @db.Uuid
  customerId String               @map("customer_id") @db.Uuid
  purpose    CustomerTokenPurpose
  tokenHash  String               @unique @map("token_hash")
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime?            @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
  @@index([expiresAt])
  @@map("customer_tokens")
}

model Address {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  fullName          String   @map("full_name")
  phone             String?
  line1             String
  line2             String?
  city              String
  /// State, province, governorate or emirate, where the country uses one.
  region            String?
  postalCode        String?  @map("postal_code")
  /// ISO 3166-1 alpha-2, uppercase.
  country           String   @db.Char(2)
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Inventory. A level is never edited on its own: every change is written
// together with a movement row that says why, so the history explains every
// number. Movements are append-only for the runtime role.
// ---------------------------------------------------------------------------

model InventoryLocation {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  address   String?
  /// Stock is taken from the default location first.
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levels       InventoryLevel[]
  movements    StockMovement[]
  reservations StockReservation[]

  @@unique([tenantId, name])
  @@map("inventory_locations")
}

/// How many of one variant are at one location. available = on_hand - reserved - damaged.
model InventoryLevel {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  /// Physically there, including reserved and damaged items.
  onHand     Int      @default(0) @map("on_hand")
  /// Promised to checkouts in progress or orders not yet shipped.
  reserved   Int      @default(0)
  /// There but not sellable.
  damaged    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([variantId, locationId])
  @@index([tenantId])
  @@index([locationId])
  @@map("inventory_levels")
}

enum StockBucket {
  on_hand
  reserved
  damaged

  @@map("stock_bucket")
}

enum StockReason {
  purchase
  sale
  return
  adjustment
  damage
  reservation
  release

  @@map("stock_reason")
}

model StockMovement {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  variantId     String      @map("variant_id") @db.Uuid
  locationId    String      @map("location_id") @db.Uuid
  /// Never zero. Positive adds to the bucket, negative takes from it.
  quantityDelta Int         @map("quantity_delta")
  bucket        StockBucket
  reason        StockReason
  /// What caused it, for example ("reservation", <id>) or ("order", <id>).
  referenceType String?     @map("reference_type")
  referenceId   String?     @map("reference_id") @db.Uuid
  actorUserId   String?     @map("actor_user_id") @db.Uuid
  note          String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor    User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

enum ReservationStatus {
  active
  /// Turned into a sale: the items left on_hand.
  committed
  /// Given back, by the shopper, the checkout, or by expiring.
  released

  @@map("reservation_status")
}

/// Items held for a checkout so two shoppers cannot buy the last one.
model StockReservation {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  quantity      Int
  status        ReservationStatus @default(active)
  /// What the hold is for, for example ("checkout", <id>).
  referenceType String            @map("reference_type")
  referenceId   String            @map("reference_id") @db.Uuid
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([referenceType, referenceId])
  @@index([status, expiresAt])
  @@index([tenantId])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------
// Orders and payments. An order copies everything it needs (names, SKUs,
// prices, addresses) at the moment it is placed, so later changes to the
// catalog or to a saved address never alter it. Its status moves only along
// allowed steps, enforced by a database trigger as well as the services.
// ---------------------------------------------------------------------------

enum OrderStatus {
  /// Placed; stock is held while the shopper pays.
  pending_payment
  /// Cash on delivery: accepted and waiting to be sent; payment is collected on delivery.
  confirmed
  paid
  fulfilled
  cancelled
  refunded

  @@map("order_status")
}

enum PaymentMethod {
  /// Paid online through the payment provider before the order is sent.
  online
  /// Paid in cash to the courier.
  cash_on_delivery

  @@map("payment_method")
}

/// Gives each store its own order numbers, starting at 1001.
model OrderCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  nextNumber Int    @default(1001) @map("next_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("order_counters")
}

model Order {
  id                 String        @id @default(uuid(7)) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  number             Int
  status             OrderStatus   @default(pending_payment)
  paymentMethod      PaymentMethod @default(online) @map("payment_method")
  /// Set only when a signed-in customer placed it. Guest orders belong to no account.
  customerId         String?       @map("customer_id") @db.Uuid
  /// The cart it came from; emptied when payment succeeds.
  cartId             String?       @map("cart_id") @db.Uuid
  email              String
  /// SHA-256 of the key in the confirmation link (the only way a guest can view the order).
  accessKeyHash      String        @unique @map("access_key_hash")
  currency           String        @db.Char(3)
  subtotalAmount     Int           @map("subtotal_amount")
  shippingAmount     Int           @default(0) @map("shipping_amount")
  taxAmount          Int           @default(0) @map("tax_amount")
  discountAmount     Int           @default(0) @map("discount_amount")
  totalAmount        Int           @map("total_amount")
  /// Money given back so far (recorded with returns). Never more than the total.
  refundedAmount     Int           @default(0) @map("refunded_amount")
  /// The delivery address as it was when the order was placed.
  shippingAddress    Json          @map("shipping_address")
  /// The delivery area chosen at checkout, copied as it was (null: the store had none).
  shippingZoneName   String?       @map("shipping_zone_name")
  /// Tax as it applied when the order was placed, in hundredths of a percent.
  taxRateBasisPoints Int           @default(0) @map("tax_rate_basis_points")
  /// Tax already inside the prices (shown for information; not added to the total).
  taxIncludedAmount  Int           @default(0) @map("tax_included_amount")
  taxLabel           String?       @map("tax_label")
  /// Stock is held until then; an unpaid order is cancelled after it.
  payBy              DateTime      @map("pay_by") @db.Timestamptz(3)
  placedAt           DateTime      @default(now()) @map("placed_at") @db.Timestamptz(3)
  paidAt             DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cart     Cart?         @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  events   OrderEvent[]
  payments Payment[]
  shipment Shipment?
  returns  OrderReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, placedAt])
  @@index([customerId, placedAt])
  @@index([status, payBy])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  /// Kept for reports; null if the variant is later deleted. The copies below stay.
  variantId       String?  @map("variant_id") @db.Uuid
  productName     String   @map("product_name")
  sku             String
  color           String?
  size            String?
  quantity        Int
  unitPriceAmount Int      @map("unit_price_amount")
  lineTotalAmount Int      @map("line_total_amount")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems OrderReturnItem[]

  @@index([orderId])
  @@index([tenantId])
  @@map("order_items")
}

/// The order's history: every status change and note, newest last.
model OrderEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  type        String
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus? @map("to_status")
  /// "customer", "staff", "payment_provider" or "system".
  actorType   String       @map("actor_type")
  actorUserId String?      @map("actor_user_id") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Where the store delivers and what it charges. Amounts are minor units of `currency`.
model ShippingZone {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// What the shopper picks at checkout, e.g. "Beirut" or "Rest of Lebanon".
  name           String
  /// Country codes (ISO 3166-1 alpha-2) this area is in.
  countries      String[]
  rateAmount     Int      @map("rate_amount")
  /// Delivery is free when the items come to at least this much.
  freeOverAmount Int?     @map("free_over_amount")
  currency       String   @db.Char(3)
  /// Switched-off areas are kept but not offered at checkout.
  isActive       Boolean  @default(true) @map("is_active")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, position])
  @@map("shipping_zones")
}

/// Items a customer gave back, recorded by staff, with any money refunded.
model OrderReturn {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  /// changed_mind, damaged, wrong_item, not_as_described or other.
  reason          String
  note            String?
  /// Minor units of the order's currency; 0 when no money was given back.
  refundAmount    Int      @default(0) @map("refund_amount")
  /// cash, bank_transfer or other; null when nothing was refunded.
  refundMethod    String?  @map("refund_method")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items  OrderReturnItem[]

  @@index([orderId])
  @@index([tenantId, createdAt])
  @@map("order_returns")
}

model OrderReturnItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  returnId    String   @map("return_id") @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  quantity    Int
  /// resellable (back on sale) or damaged (kept apart, not for sale).
  condition   String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([orderItemId])
  @@map("order_return_items")
}

/// One row per store: which staff addresses get store emails.
model NotificationSettings {
  tenantId    String   @id @map("tenant_id") @db.Uuid
  /// Told about each new order (cash on delivery placed, or paid online).
  orderEmails String[] @map("order_emails")
  /// Told when a product's stock drops to its low-stock level.
  stockEmails String[] @map("stock_emails")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// One row per store: how tax is charged at checkout.
model CheckoutSettings {
  tenantId           String   @id @map("tenant_id") @db.Uuid
  /// Hundredths of a percent: 1100 is 11%. 0 means no tax is shown or charged.
  taxRateBasisPoints Int      @default(0) @map("tax_rate_basis_points")
  /// True: prices already include the tax. False: it is added at checkout.
  taxIncluded        Boolean  @default(true) @map("tax_included")
  taxLabel           String   @default("VAT") @map("tax_label")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("checkout_settings")
}

/// How an order was sent: one per order, recorded when staff mark it as sent.
model Shipment {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  orderId           String   @unique @map("order_id") @db.Uuid
  courier           String?
  trackingReference String?  @map("tracking_reference")
  /// Only https links are stored.
  trackingUrl       String?  @map("tracking_url")
  shippedAt         DateTime @default(now()) @map("shipped_at") @db.Timestamptz(3)
  createdByUserId   String?  @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("shipments")
}

enum PaymentStatus {
  /// Created; the shopper has not finished paying.
  pending
  succeeded
  failed
  /// Given up (the order was cancelled before payment finished).
  cancelled

  @@map("payment_status")
}

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String
  /// The provider's own reference. Card details never reach this application.
  providerPaymentId String        @unique @map("provider_payment_id")
  status            PaymentStatus @default(pending)
  amount            Int
  currency          String        @db.Char(3)
  /// Only what the provider reports for display, e.g. "Visa" and "4242". Never a full number.
  methodBrand       String?       @map("method_brand")
  methodLast4       String?       @map("method_last4")
  failureMessage    String?       @map("failure_message")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@index([orderId])
  @@index([tenantId])
  @@map("payments")
}

/// Every notification received from a payment provider, once each.
model PaymentEvent {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  provider          String
  /// The provider's ID for the notification; a repeat with the same ID is ignored.
  providerEventId   String   @map("provider_event_id")
  type              String
  payload           Json
  signatureVerified Boolean  @map("signature_verified")
  processedAt       DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_events")
}
